{
  "name": "@areche/tmux-mcp",
  "version": "0.1.0",
  "description": "MCP server for listing and driving tmux/byobu sessions from inside a container",
  "type": "module",
  "bin": {
    "tmux-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "TMUX_MCP_INTEGRATION=1 vitest run test/integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "mcp",
    "tmux",
    "byobu",
    "distrobox"
  ],
  "license": "MIT"
}
